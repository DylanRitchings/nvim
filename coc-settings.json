{
  "suggest.noselect": false,
  "suggest.enablePreselect": true,
  "suggest.minTriggerInputLength": 1,
  "suggest.triggerAfterInsertEnter": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnusedFunction": "warning",
    "reportUnusedVariable": "warning",
    "reportUnusedImport": "warning"
  },
  "languageserver": {
    "nix": {
      "command": "nixd",
      "filetypes": ["nix"],
      "rootPatterns": ["flake.nix", ".git"]
    },
    "python": {
      "command": "pyright-langserver",
      "args": [
        "--stdio"
      ],
      "filetypes": [
        "python"
      ],
      "trace.server": "verbose",
      "settings": {}
    },
    "github-actions": {
      "command": "npx",
      "args": [
        "-y",
        "gh-actions-language-server",
        "--stdio"
      ],
      "filetypes": [
        "yaml",
        "yml"
      ],
      "rootPatterns": [
        ".git",
        ".github/workflows"
      ],
      "settings": {}
    }
  },
  "toml.formatter.indentString": "    ",
  "toml.formatter.arrayAutoCollapse": false,
  "toml.formatter.compactArrays": true,
  "toml.formatter.compactInlineTables": true,
  "toml.formatter.columnWidth": 120,
  "[toml]": {
    "coc.preferences.formatOnSave": false
  },
  "coc.preferences.formatOnSave": true,
  "markdownlint.config": {
    "MD013": false
  }
}
